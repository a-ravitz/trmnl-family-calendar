  .ag-wrap { width: 100%; height: 100%; display: flex; flex-direction: column; overflow: hidden;
    font-family: -apple-system, 'Helvetica Neue', Arial, sans-serif; -webkit-font-smoothing: none; color: #000; }
  .ag-cols { flex: 1; display: flex; flex-direction: column; min-height: 0; }
  .ag-row { flex: 1; display: flex; min-height: 0; }
  .ag-row + .ag-row { border-top: 2px solid #000; }
  .ag-col { flex: 1; display: flex; flex-direction: column; min-width: 0; border-left: 2px solid #000; }
  .ag-col:first-child { border-left: none; }

